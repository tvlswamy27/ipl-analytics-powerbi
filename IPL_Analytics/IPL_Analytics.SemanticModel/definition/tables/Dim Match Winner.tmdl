table 'Dim Match Winner'
	lineageTag: d9769a3e-4d20-4fe0-9c99-0b20ff9e1323

	column team_id
		dataType: int64
		lineageTag: 1929df89-0de5-4601-9a61-a297376395bf
		summarizeBy: none
