table 'Dim Team'
	lineageTag: 1f9b3f9b-35e4-48df-a3b7-c5903061d9bb

	column team_id
		dataType: int64
		lineageTag: cc47317f-c22b-4a19-9d89-3f1fa0f7d880
		summarizeBy: none
		sourceColumn: team_id

		annotation SummarizationSetBy = Automatic

	column team_name
		dataType: string
		lineageTag: 09f3ad26-5e04-4112-960e-fc0c908cfe4a
		summarizeBy: none
		sourceColumn: team_name

		annotation SummarizationSetBy = Automatic

	column 'Team Color' = SWITCH('Dim Team'[team_name], "Mumbai Indians", "#004BA0", "Chennai Super Kings", "#F9CD05", "Royal Challengers Bangalore", "#D1171B", "Royal Challengers Bengaluru", "#D1171B", "Kolkata Knight Riders", "#3A225D", "Sunrisers Hyderabad", "#F26522", "Punjab Kings", "#ED1B24", "Kings XI Punjab", "#ED1B24", "Delhi Capitals", "#17479E", "Delhi Daredevils", "#17479E", "Rajasthan Royals", "#EA1A85", "Gujarat Titans", "#1C2C5B", "Lucknow Super Giants", "#00A6E0", "#808080")
		dataType: string
		lineageTag: 8ce709f2-a143-4321-ae71-52a17e11c1d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Dim Team' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(WorkspaceDataPath & "teams_data.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"team_id", Int64.Type}, {"team_name", type text}})
				in
				    ChangedType

