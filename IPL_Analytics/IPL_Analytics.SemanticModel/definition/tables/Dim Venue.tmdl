table 'Dim Venue'
	lineageTag: 90413916-3750-49b0-9035-4e98a033c25f

	column venue
		dataType: string
		lineageTag: de747d19-e28d-4f49-95be-e08140955c2e
		summarizeBy: none
		sourceColumn: venue

		annotation SummarizationSetBy = Automatic

	column city
		dataType: string
		lineageTag: 55fa63da-23cc-4c0f-9910-36a57f2102a2
		summarizeBy: none
		sourceColumn: city

		annotation SummarizationSetBy = Automatic

	partition 'Dim Venue' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(WorkspaceDataPath & "ipl_matches_data.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"venue", type text}, {"city", type text}}),
				    SelectedCols = Table.SelectColumns(ChangedType,{"venue", "city"}),
				    Distinct = Table.Distinct(SelectedCols, {"venue"}),
				    FilteredRows = Table.SelectRows(Distinct, each ([venue] <> null))
				in
				    FilteredRows

